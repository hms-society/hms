# =============================================================================
# Local Docker Compose environment (docker-compose.yaml)
# =============================================================================
# Copy to `.env` and adjust as needed:  cp .env.example .env
#
# The values below are safe DEFAULTS for LOCAL development only. The ANON_KEY
# and SERVICE_ROLE_KEY are the well-known Supabase demo keys, signed with the
# default JWT_SECRET below — DO NOT use any of these in staging/production.

# --- Supabase Postgres (main application database) ---------------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- JWT (shared by Auth, REST, Storage and DB RLS) --------------------------
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXP=3600

# Demo keys signed with the JWT_SECRET above.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# --- Meta Cloud API (WhatsApp) -----------------------------------------------
WHATSAPP_API_TOKEN=change-me-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=change-me-whatsapp-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=vibecoding
WHATSAPP_APP_SECRET=change-me-whatsapp-app-secret

# --- Supabase API gateway (Kong) ---------------------------------------------
KONG_HTTP_PORT=8000
SUPABASE_PUBLIC_URL=http://localhost:8000

# --- Auth (GoTrue) -----------------------------------------------------------
SITE_URL=http://localhost:3000
SMTP_USER=fake
SMTP_PASS=fake
SMTP_ADMIN_EMAIL=admin@hms.local
SMTP_SENDER_NAME=HMS

# --- Mailpit -----------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Storage -----------------------------------------------------------------
STORAGE_FILE_SIZE_LIMIT=52428800
STORAGE_REGION=sa-east-1
