# =============================================================================
# Local Docker Compose environment (docker-compose.yaml)
# =============================================================================
# Copy to `.env` and adjust as needed:  cp .env.example .env
#
# The values below are for LOCAL development only. Generate the JWT keys after
# copying this file to `.env` with: ./scripts/generate-supabase-keys.sh

# --- Supabase Postgres (main application database) ---------------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- JWT (shared by Auth, REST, Storage and DB RLS) --------------------------
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXP=3600

# Generated local keys.
ANON_KEY=replace-with-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-service-role-jwt

# --- Meta Cloud API (WhatsApp) & Webhook Tunnel ------------------------------
WHATSAPP_API_TOKEN=change-me-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=change-me-whatsapp-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=vibecoding
WHATSAPP_APP_SECRET=change-me-whatsapp-app-secret
NGROK_DOMAIN=buckle-stinger-swoop.ngrok-free.dev

# --- Supabase API gateway (Kong) ---------------------------------------------
KONG_HTTP_PORT=8000
SUPABASE_PUBLIC_URL=http://localhost:8000
STUDIO_PORT=3001
STUDIO_DEFAULT_ORGANIZATION=HMS
STUDIO_DEFAULT_PROJECT=HMS Local
PG_META_CRYPTO_KEY=replace-with-a-local-pg-meta-key

# --- Auth (GoTrue) -----------------------------------------------------------
SITE_URL=http://localhost:5000
HMS_WEB_APP_URL=http://localhost:5000
HMS_WEB_APP_PORT=5000
HMS_SERVER_APP_PORT=5555
SMTP_USER=fake
SMTP_PASS=fake
SMTP_ADMIN_EMAIL=admin@hms.local
SMTP_SENDER_NAME=HMS

# --- Mailpit -----------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_API_URL=http://127.0.0.1:8025

# --- Storage -----------------------------------------------------------------
STORAGE_FILE_SIZE_LIMIT=52428800
STORAGE_REGION=sa-east-1

# --- Formalization Signing Gateway -------------------------------------------
DOCUMENSO_PORT=3004
DOCUMENSO_POSTGRES_DB=documenso
DOCUMENSO_POSTGRES_USER=documenso
DOCUMENSO_POSTGRES_PASSWORD=documenso-local-only
DOCUMENSO_PUBLIC_WEBAPP_URL=http://localhost:3004
DOCUMENSO_INTERNAL_WEB_APP_URL=http://documenso:3000
DOCUMENSO_BASE_PATH=
DOCUMENSO_DISABLE_EMAIL_PASSWORD_SIGNUP=true
DOCUMENSO_NEXTAUTH_SECRET=local-only-change-me
DOCUMENSO_ENCRYPTION_KEY=local-only-change-me
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=local-only-secondary-encryption-key-change-me
DOCUMENSO_SIGNING_PASSPHRASE=
DOCUMENSO_SMTP_TRANSPORT=smtp-auth
DOCUMENSO_SMTP_HOST=mailpit
DOCUMENSO_SMTP_PORT=1025
DOCUMENSO_SMTP_USERNAME=
DOCUMENSO_SMTP_PASSWORD=
DOCUMENSO_SMTP_SECURE=false
DOCUMENSO_SMTP_FROM_ADDRESS=documenso@localhost
DOCUMENSO_SMTP_FROM_NAME=Documenso
DOCUMENSO_RESEND_API_KEY=
DOCUMENSO_ADMIN_NAME=HMS Local Admin
DOCUMENSO_ADMIN_EMAIL=
DOCUMENSO_ADMIN_PASSWORD=
DOCUMENSO_PRIVATE_BASE_URL=http://127.0.0.1:3004
DOCUMENSO_API_V2_KEY=
DOCUMENSO_WEBHOOK_SECRET=
DOCUMENSO_EXPECTED_VERSION=2.17.0
HMS_SIGNING_OTP_PEPPER=
HMS_SIGNING_IP_FINGERPRINT_KEY=
HMS_SIGNING_CIPHER=aes-256-gcm
HMS_SIGNING_CIPHER_KEY_ID=local
HMS_SIGNING_PROXY_PUBLIC_PREFIX=/assinaturas/provedor
HMS_SIGNING_INVITATION_MAX_AGE_SECONDS=604800
HMS_SIGNING_SESSION_MAX_AGE_SECONDS=86400
HMS_SIGNING_RESULT_MAX_AGE_SECONDS=86400
HMS_SIGNING_PROXY_IDLE_TIMEOUT_SECONDS=1800
HMS_SIGNING_OTP_EXPIRY_SECONDS=1800
HMS_SIGNING_OTP_COOLDOWN_SECONDS=60
RESEND_API_KEY=
HMS_SIGNING_EMAIL_FROM=
