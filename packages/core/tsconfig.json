{
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "#communication/*": ["./src/communication/*"],
      "#consultation/*": ["./src/consultation/*"],
      "#document-engine/*": ["./src/document-engine/*"],
      "#document-production/*": ["./src/document-production/*"],
      "#identity/*": ["./src/identity/*"],
      "#legal-catalog/*": ["./src/legal-catalog/*"],
      "#scheduling/*": ["./src/scheduling/*"],
      "#shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
