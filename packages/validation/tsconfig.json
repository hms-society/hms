{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "#consultation/*": ["../core/src/consultation/*"],
      "#shared/*": ["../core/src/shared/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
