@url = {{BASE_URL}}/document-specifications
@legalAreaId = replace-with-legal-area-uuid
@legalTopicId = replace-with-legal-topic-uuid

# Preconditions
# Run `pnpm seed`, start the API on http://localhost:3333, and execute the
# login request before sending the document specification requests.

### Sign in as the seeded administrator
# @name signInAsSeededAdmin
# @prompt seedPassword Enter HMS_USER_SEED_PASSWORD
POST {{BASE_URL}}/auth/sign-in
Content-Type: application/json
Accept: application/json

{
  "identifier": "admin@hmsadvogados.com.br",
  "password": "{{seedPassword}}"
}

### List document specifications
GET {{url}}?page=1&pageSize=20
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

### Filter document specifications
GET {{url}}?search=contrato&moment=formalization&status=available
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

### Create global document specification
# @name createGlobalDocumentSpecification
POST {{url}}
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Modelo de identificação",
  "description": "Documento de identificação do cliente.",
  "application": { "scope": "global", "moment": "consultation" },
  "content": {
    "type": "doc",
    "content": [{
      "type": "paragraph",
      "content": [{ "type": "text", "text": "Identificação do cliente." }]
    }]
  },
  "variables": []
}

### Create legal-context document specification
POST {{url}}
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Modelo jurídico",
  "description": "Modelo para uma área jurídica.",
  "application": {
    "scope": "legal_context",
    "moment": "legal_production",
    "legalAreaIds": ["{{legalAreaId}}"],
    "legalTopicIdsByArea": { "{{legalAreaId}}": ["{{legalTopicId}}"] }
  },
  "content": {
    "type": "doc",
    "content": [{
      "type": "paragraph",
      "content": [{ "type": "text", "text": "Modelo jurídico de exemplo." }]
    }]
  },
  "variables": []
}

### Get document specification
GET {{url}}/{{createGlobalDocumentSpecification.response.body.$.documentSpecificationId}}
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

### Update configuration
PATCH {{url}}/{{createGlobalDocumentSpecification.response.body.$.documentSpecificationId}}/configuration
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Modelo atualizado",
  "description": "Descrição atualizada.",
  "status": "unavailable",
  "application": { "scope": "global", "moment": "formalization" }
}

### Update template
PATCH {{url}}/{{createGlobalDocumentSpecification.response.body.$.documentSpecificationId}}/template
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "content": {
    "type": "doc",
    "content": [{
      "type": "paragraph",
      "content": [{ "type": "text", "text": "Conteúdo de exemplo" }]
    }]
  },
  "variables": [{
    "label": "Nome do contrato",
    "technicalName": "nome_contrato",
    "description": "Nome usado no contrato"
  }]
}

### Reject invalid query
GET {{url}}?pageSize=0
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

### Delete the created document specification
DELETE {{url}}/{{createGlobalDocumentSpecification.response.body.$.documentSpecificationId}}
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
