# Preconditions
# Run `pnpm seed`, start the API on http://localhost:3333, and replace the
# UUID placeholders using the identity and legal-catalog REST clients.

@url = {{BASE_URL}}/intakes
@intakeId = replace-with-intake-uuid
@clientId = replace-with-client-uuid
@userId = replace-with-collaborator-uuid
@legalAreaId = replace-with-legal-area-uuid
@legalTopicId = replace-with-legal-topic-uuid
@lawyerId = replace-with-lawyer-uuid

### Sign in as the seeded administrator
# @name signInAsSeededAdmin
# @prompt seedPassword Enter HMS_USER_SEED_PASSWORD
POST {{BASE_URL}}/auth/sign-in
Content-Type: application/json
Accept: application/json

{
  "identifier": "admin@hmsadvogados.com.br",
  "password": "{{seedPassword}}"
}

### Confirm the authenticated administrator
GET {{BASE_URL}}/collaborators/me
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
Accept: application/json

### List intakes
GET {{url}}?search=&status=consultation_scheduled&responsibleId={{userId}}&origin=direct&contactChannel=whatsapp&page=1&pageSize=20
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

### List intake responsible options
GET {{url}}/responsibles
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

### Register intake
POST {{url}}
Content-Type: application/json
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

{
  "decision": "schedule_consultation",
  "assignedLawyerId": "{{lawyerId}}",
  "startsAt": "2026-08-13T13:00:00.000Z",
  "modality": "virtual",
  "channel": "google_meet",
  "clientId": "{{clientId}}",
  "responsibleId": "{{userId}}",
  "origin": "direct",
  "contactChannel": "whatsapp",
  "legalAreaId": "{{legalAreaId}}",
  "legalTopicId": "{{legalTopicId}}",
  "urgency": "normal",
  "demandNotes": "Orientação sobre a demanda do cliente"
}

### Retry consultation scheduling
POST {{url}}/{{intakeId}}/consultation-scheduling/retry
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "assignedLawyerId": "{{lawyerId}}",
  "startsAt": "2026-08-13T13:00:00.000Z",
  "modality": "virtual",
  "channel": "google_meet"
}

### Register intake without scheduling
POST {{url}}
Content-Type: application/json
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

{
  "decision": "register_intake",
  "clientId": "{{clientId}}",
  "responsibleId": "{{userId}}",
  "origin": "direct",
  "contactChannel": "whatsapp",
  "legalAreaId": "{{legalAreaId}}",
  "legalTopicId": "{{legalTopicId}}",
  "urgency": "normal",
  "demandNotes": "Novo Intake sem agendamento neste momento."
}

### Get intake
GET {{url}}/{{intakeId}}
Content-Type: application/json
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

### List client intakes
GET {{url}}/clients/{{clientId}}
Content-Type: application/json
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

### Transition intake status
PATCH {{url}}/{{intakeId}}/status
Content-Type: application/json
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

{
  "expectedVersion": 1,
  "status": "consultation_completed",
  "updatedBy": "{{userId}}"
}

### Update intake editable fields
PATCH {{url}}/{{intakeId}}
Content-Type: application/json
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

{
  "expectedVersion": 1,
  "updatedBy": "{{userId}}",
  "responsibleId": "{{userId}}",
  "origin": "direct",
  "contactChannel": "whatsapp",
  "legalAreaId": "{{legalAreaId}}",
  "legalTopicId": "{{legalTopicId}}",
  "urgency": "normal",
  "demandNotes": "Orientação atualizada sobre a demanda do cliente."
}

### Close intake without contract
POST {{url}}/{{intakeId}}/close
Content-Type: application/json
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}

{
  "expectedVersion": 1,
  "closureReason": "out_of_scope",
  "updatedBy": "{{userId}}"
}
