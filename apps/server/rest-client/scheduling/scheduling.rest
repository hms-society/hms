# Preconditions: start the API at http://localhost:3333 and provide a seeded token.
@BASE_URL = http://localhost:3333
@accessToken = {{ACCESS_TOKEN}}
@appointmentId = replace-with-appointment-uuid
@scheduleId = replace-with-schedule-uuid
@collaboratorId = replace-with-collaborator-uuid
@lawyerId = replace-with-active-lawyer-uuid
@revision = 2026-09-24T12:00:00.000Z

### Calendar (week)
GET {{BASE_URL}}/scheduling/calendar?view=week&date=2026-09-24&event=all
Authorization: Bearer {{accessToken}}
Accept: application/json

### Calendar (month with filters)
GET {{BASE_URL}}/scheduling/calendar?view=month&date=2026-09-01&clientId={{CLIENT_ID}}&lawyerId={{collaboratorId}}&event=scheduled
Authorization: Bearer {{accessToken}}
Accept: application/json

### Calendar filter options
GET {{BASE_URL}}/scheduling/calendar/filters?kind=client&search=&cursor=
Authorization: Bearer {{accessToken}}
Accept: application/json

### Appointment details
GET {{BASE_URL}}/scheduling/appointments/{{appointmentId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Reschedule slots
GET {{BASE_URL}}/scheduling/appointments/{{appointmentId}}/slots?date=2026-09-25&lawyerId={{lawyerId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Cancel appointment
PATCH {{BASE_URL}}/scheduling/appointments/{{appointmentId}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "expectedRevision": "{{revision}}"
}

### Reschedule appointment
PATCH {{BASE_URL}}/scheduling/appointments/{{appointmentId}}/reschedule
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "expectedRevision": "{{revision}}",
  "startsAt": "2026-09-25T14:00:00.000Z",
  "lawyerId": "{{lawyerId}}"
}

### Legacy: get schedule by collaborator
GET {{BASE_URL}}/schedules/collaborator/{{collaboratorId}}
Authorization: Bearer {{accessToken}}

### Legacy: update availability
PUT {{BASE_URL}}/schedules/availability
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "scheduleId": "{{scheduleId}}",
  "weeklyAvailability": []
}

### Legacy: update duration
PUT {{BASE_URL}}/schedules/duration
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "scheduleId": "{{scheduleId}}",
  "defaultDurationMinutes": 45
}

### Consultation details
GET {{BASE_URL}}/consultations/{{CONSULTATION_ID}}
Authorization: Bearer {{accessToken}}

### Consultation by intake
GET {{BASE_URL}}/consultations/by-intake/{{INTAKE_ID}}
Authorization: Bearer {{accessToken}}

### Finalize consultation attendance
PATCH {{BASE_URL}}/consultations/{{CONSULTATION_ID}}/attendance/finalize
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "legalAreaId": "{{LEGAL_AREA_ID}}",
  "legalTopicId": "{{LEGAL_TOPIC_ID}}",
  "modality": "virtual",
  "channel": "google_meet",
  "primaryLegalQuestion": "Pergunta principal",
  "guidanceProvided": "Orientação prestada",
  "viability": "Viável",
  "decision": "Prosseguir para contratação"
}

### Complete consultation
PATCH {{BASE_URL}}/consultations/{{CONSULTATION_ID}}/complete
Authorization: Bearer {{accessToken}}
