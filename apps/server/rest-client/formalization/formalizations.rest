@baseUrl = http://localhost:5555
@formalizationId = 00000000-0000-4000-8000-000000000701
@intakeId = 00000000-0000-4000-8000-000000000101
@documentId = 00000000-0000-4000-8000-000000000201
@versionId = 00000000-0000-4000-8000-000000000501
@signatoryId = 00000000-0000-4000-8000-000000000601
@previewId = 00000000-0000-4000-8000-000000000602
@personId = 00000000-0000-4000-8000-000000000603

### Start or retrieve the assigned-lawyer Formalization
POST {{baseUrl}}/formalizations/by-intake/{{intakeId}}/start
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}

### Read the Formalization
GET {{baseUrl}}/formalizations/{{formalizationId}}
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}

### Save a draft
PATCH {{baseUrl}}/formalizations/{{formalizationId}}/contract-form/draft
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "expectedVersion": 1,
  "answers": []
}

### Close the commercial conditions form
PATCH {{baseUrl}}/formalizations/{{formalizationId}}/contract-form/close
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "expectedVersion": 2,
  "answers": []
}

### List available document specifications
GET {{baseUrl}}/formalizations/{{formalizationId}}/documents/selection
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}

### Request one individual generation
POST {{baseUrl}}/formalizations/{{formalizationId}}/documents/{{documentId}}/generations
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{}

### Review a document version
PATCH {{baseUrl}}/formalizations/{{formalizationId}}/document-versions/{{versionId}}/review
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "status": "approved"
}

### Confirm the current document set
PATCH {{baseUrl}}/formalizations/{{formalizationId}}/documents/confirm
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "expectedVersion": 3
}

### Read signature configuration
GET {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}

### Initialize signature configuration
POST {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration/initialize
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "expectedVersion": 4
}

### Search eligible signatory candidates
GET {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration/candidates?page=1&limit=20&search=Silva
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}

### Add a contextual signatory
POST {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration/signatories
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "personId": "{{personId}}",
  "expectedVersion": 4
}

### Remove a contextual signatory
DELETE {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration/signatories/{{signatoryId}}
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "expectedVersion": 5
}

### Replace signatory document assignments
PUT {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration/signatories/{{signatoryId}}/documents
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "documentIds": ["{{documentId}}"],
  "expectedVersion": 5
}

### Select a signatory channel
PUT {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration/signatories/{{signatoryId}}/channel
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "channel": "email",
  "expectedVersion": 6
}

### Retry a failed signature preview
POST {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration/previews/{{previewId}}/retry
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "expectedVersion": 7
}

### Stream a private signature preview PDF
GET {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration/previews/{{previewId}}/content
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}

### Replace signature fields
PUT {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration/documents/{{documentId}}/fields
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "previewId": "{{previewId}}",
  "expectedVersion": 8,
  "fields": [
    {
      "fieldId": "00000000-0000-4000-8000-000000000604",
      "signatoryId": "{{signatoryId}}",
      "previewId": "{{previewId}}",
      "type": "signature",
      "page": 1,
      "positionX": 10,
      "positionY": 75,
      "width": 30,
      "height": 10
    }
  ]
}

### Reset signature configuration
POST {{baseUrl}}/formalizations/{{formalizationId}}/signature-configuration/reset
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "expectedVersion": 9
}

### Reopen the document package
PATCH {{baseUrl}}/formalizations/{{formalizationId}}/documents/reopen
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "expectedVersion": 10
}

### Close without contract
PATCH {{baseUrl}}/formalizations/{{formalizationId}}/close-without-contract
Authorization: Bearer {{$dotenv HMS_REST_TOKEN}}
Content-Type: application/json

{
  "expectedVersion": 3,
  "expectedIntakeVersion": 2,
  "reason": "client_withdrew",
  "notes": ""
}
