@url = {{BASE_URL}}/clients
@clientId = replace-with-client-uuid
@accessToken = {{ACCESS_TOKEN}}

# List and consent routes require a valid seeded session. Public lookup and
# registration requests below do not require the token.

### Lookup client
POST {{url}}/lookup
Content-Type: application/json

{
  "taxId": "123.456.789-00",
  "phone": "(11) 91234-5678"
}

### Get client
GET {{url}}/{{clientId}}
Content-Type: application/json

### List clients
GET {{url}}?page=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json

### Register natural client
POST {{url}}
Content-Type: application/json

{
  "type": "natural",
  "name": "Ricardo Alves de Souza",
  "taxId": "529.982.247-25",
  "phone": "(12) 99876-3322",
  "email": "ricardo.alves@example.com"
}

### Grant client consent
POST {{url}}/{{clientId}}/consents
Content-Type: application/json

{
  "type": "data_processing"
}
