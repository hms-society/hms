@baseUrl = http://localhost:3333
@seedPassword = {{$dotenv HMS_USER_SEED_PASSWORD}}

### Sign in as seeded admin
# @name signInAsSeededAdmin
POST {{baseUrl}}/auth/sign-in
Content-Type: application/json
Accept: application/json

{
  "identifier": "admin@hmsadvogados.com.br",
  "password": "{{seedPassword}}"
}

### Upload procuracao simulada for AI extraction
# Sends one PDF and creates one document batch, so only one Inngest run starts.
# @prompt clientId Enter the client ID
POST {{baseUrl}}/document-batches/internal-upload
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="clientId"

{{clientId}}
--boundary
Content-Disposition: form-data; name="files"; filename="procuracao.pdf"
Content-Type: application/pdf

< ../../src/document-engine/database/seed-assets/procuracao.pdf
--boundary--

### Upload comprovante de endereço simulado for AI extraction
# Sends one PDF and creates one document batch, so only one Inngest run starts.
# @prompt clientId Enter the client ID
POST {{baseUrl}}/document-batches/internal-upload
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="clientId"

{{clientId}}
--boundary
Content-Disposition: form-data; name="files"; filename="comprovante_endereco.pdf"
Content-Type: application/pdf

< ../../src/document-engine/database/seed-assets/comprovante_endereco.pdf
--boundary--

### List document batches in triage
GET {{baseUrl}}/document-batches/triage?page=1&limit=10
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
Accept: application/json
