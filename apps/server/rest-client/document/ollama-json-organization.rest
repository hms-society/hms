### Trigger Ollama JSON organization run directly in Inngest
# This bypasses the main image OCR workflow. The file must already exist in storage.
# In local dev without INNGEST_EVENT_KEY, the SDK sends events through NO_EVENT_KEY_SET.
POST {{inngestUrl}}/e/{{inngestEventKey}}
Content-Type: application/json

[
  {
    "name": "document-engine/document-file.json-organization-requested",
    "data": {
      "batchId": "{{batchId}}",
      "documentFileId": "{{documentFileId}}",
      "storagePath": "{{storagePath}}",
      "originalName": "{{originalName}}",
      "mimeType": "{{mimeType}}",
      "sizeBytes": {{sizeBytes}},
      "hashSha256": "{{hashSha256}}",
      "extractedTextFull": "{{extractedTextFull}}"
    }
  }
]

### Sign in as seeded admin
# @name signInAsSeededAdmin
POST {{baseUrl}}/auth/sign-in
Content-Type: application/json
Accept: application/json

{
  "identifier": "admin@hmsadvogados.com.br",
  "password": "{{seedPassword}}"
}

### Check document after Ollama run
GET {{baseUrl}}/document-validation/documents/{{documentFileId}}
Authorization: Bearer {{signInAsSeededAdmin.response.body.$.accessToken}}
Accept: application/json
