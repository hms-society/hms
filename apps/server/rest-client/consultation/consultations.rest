# Preconditions
# Run `pnpm seed`, start the API on http://localhost:5555, and replace the
# legal/dynamic-form/document-specification placeholders with IDs returned by
# the requests in this directory and apps/server/rest-client/shared/.

@url = {{BASE_URL}}/consultations
@consultationId = 00000000-0000-4000-8000-000000000101
@legalAreaId = replace-with-legal-area-uuid
@legalTopicId = replace-with-legal-topic-uuid
@dynamicFormId = replace-with-dynamic-form-uuid
@powerOfAttorneyDocumentId = 00000000-0000-4000-8000-000000000201
@consultationStatementDocumentId = 00000000-0000-4000-8000-000000000202
@reviewChallengeDocumentId = 00000000-0000-4000-8000-000000000203


### Sign in as the seeded lawyer
# @name signInAsSeededLawyer
# @prompt seedPassword Enter HMS_USER_SEED_PASSWORD
POST {{BASE_URL}}/auth/sign-in
Content-Type: application/json
Accept: application/json

{
  "identifier": "lawyer@hmsadvogados.com.br",
  "password": "{{seedPassword}}"
}

### Confirm the authenticated collaborator
GET {{BASE_URL}}/collaborators/me
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Get consultation details
# @name getConsultation
GET {{url}}/{{consultationId}}
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Get consultation by intake
# @prompt intakeId Copy the intake ID from the consultation details response
# @name getConsultationByIntake
GET {{url}}/by-intake/{{intakeId}}
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Reopen the attendance form for editing
PATCH {{url}}/{{consultationId}}/attendance/edit
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### List available dynamic forms for the consultation context
# @name listDynamicFormsForConsultation
GET {{BASE_URL}}/dynamic-forms?legalAreaId={{legalAreaId}}&legalTopicId={{legalTopicId}}
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Finalize the attendance form
# Expected: 200. The viability and decision values are intentionally coupled by backend validation.
# @name finalizeConsultationAttendance
PATCH {{url}}/{{consultationId}}/attendance/finalize
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json
Accept: application/json

{
  "legalAreaId": "{{legalAreaId}}",
  "legalTopicId": "{{legalTopicId}}",
  "modality": "virtual",
  "channel": "google_meet",
  "primaryLegalQuestion": "Quais poderes são necessários para representar o cliente?",
  "guidanceProvided": "Orientação jurídica prestada durante a consulta.",
  "viability": "Viável",
  "decision": "Prosseguir para contratação",
  "dynamicFormId": "{{dynamicFormId}}",
  "answers": [
    {
      "fieldId": "civil-relationship",
      "value": ["contracts"]
    },
    {
      "fieldId": "civil-facts",
      "value": "O cliente precisa negociar um contrato de locação residencial."
    }
  ],
  "notes": "Observações complementares da consulta.",
  "relevantFacts": [],
  "potentialLegalRequests": []
}

### List the consultation document selection
# @name listConsultationDocumentSelection
GET {{url}}/{{consultationId}}/documents/selection
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Replace the consultation document selection
# Copy document specification IDs from the selection response before sending.
# @name replaceConsultationDocumentSelection
PUT {{url}}/{{consultationId}}/documents/selection
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json
Accept: application/json

{
  "documentSpecificationIds": [
    "replace-with-document-specification-uuid"
  ]
}

### Confirm the consultation document package
# Expected: 200 after every selected document has an approved or rejected version.
# @name confirmConsultationDocumentPackage
PATCH {{url}}/{{consultationId}}/documents/package/confirm
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Reopen the consultation document package for editing
# Expected: 204. This clears the current package confirmation and unlocks selection,
# generation, review and version changes until the package is confirmed again.
# @name reopenConsultationDocumentPackage
PATCH {{url}}/{{consultationId}}/documents/package/reopen
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

# Individual path: execute this request and wait for the Inngest run to finish
# before requesting the same document again.

### Generate the seeded power of attorney
# @name generatePowerOfAttorney
POST {{url}}/{{consultationId}}/documents/{{powerOfAttorneyDocumentId}}/generations
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Generate the seeded consultation statement
# @name generateConsultationStatement
POST {{url}}/{{consultationId}}/documents/{{consultationStatementDocumentId}}/generations
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Cancel an active document generation
# Expected: 204. Follow with the list request to confirm the UI can leave the loading state.
# @name cancelConsultationDocumentGeneration
POST {{url}}/{{consultationId}}/documents/{{consultationStatementDocumentId}}/generations/cancel
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Challenge the reviewer with an intentionally inconsistent document
# @name generateReviewChallengeDocument
POST {{url}}/{{consultationId}}/documents/{{reviewChallengeDocumentId}}/generations
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

# The seeded template contradicts both itself and the consultation source. A
# successful review cycle should either require one or more revisions or finish
# the generation as failed with understandable findings after three attempts.

# Batch path: after a fresh db:seed, execute this request instead of the two
# individual requests. It requests every eligible document in the package.

### Generate all eligible consultation documents
# @name generateAllConsultationDocuments
POST {{url}}/{{consultationId}}/document-generations/batch
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

# Generation is asynchronous. Follow the runs at http://localhost:9288.
# Wait for the generation to complete before listing its immutable version.

### List consultation documents and version history
# @name listConsultationDocuments
GET {{url}}/{{consultationId}}/documents
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Get a generated document version including its Tiptap content
# @prompt documentVersionId Copy a version ID from listConsultationDocuments
GET {{url}}/{{consultationId}}/documents/{{powerOfAttorneyDocumentId}}/versions/{{documentVersionId}}
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Save edited Tiptap content as a new immutable manual version
# @name saveManualDocumentVersion
# @prompt sourceDocumentVersionId Copy the edited source version ID
POST {{url}}/{{consultationId}}/documents/{{powerOfAttorneyDocumentId}}/versions/{{sourceDocumentVersionId}}/manual
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json
Accept: application/json

{
  "content": {
    "type": "doc",
    "content": [
      {
        "type": "heading",
        "attrs": { "level": 1, "textAlign": "center" },
        "content": [{ "type": "text", "text": "Procuração revisada" }]
      },
      {
        "type": "paragraph",
        "attrs": { "textAlign": "left" },
        "content": [
          {
            "type": "text",
            "text": "O cliente outorga poderes limitados à negociação da locação residencial."
          }
        ]
      }
    ]
  }
}

### Approve a generated document version
# @prompt documentVersionId Copy an in-review version ID
PATCH {{url}}/{{consultationId}}/documents/{{powerOfAttorneyDocumentId}}/versions/{{documentVersionId}}/review
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json
Accept: application/json

{
  "decision": "approved"
}

### Reject a generated document version
# @prompt documentVersionId Copy an in-review version ID
PATCH {{url}}/{{consultationId}}/documents/{{reviewChallengeDocumentId}}/versions/{{documentVersionId}}/review
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json
Accept: application/json

{
  "decision": "rejected",
  "rejectionReason": "A cláusula precisa ser revisada."
}

### Select an approved version as current
# @prompt documentVersionId Copy an approved version ID
PATCH {{url}}/{{consultationId}}/documents/{{powerOfAttorneyDocumentId}}/versions/{{documentVersionId}}/current
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Complete the consultation
# Expected: 200 only after the attendance and document package gates are complete.
# @name completeConsultation
PATCH {{url}}/{{consultationId}}/complete
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Verify the consultation is readonly after completion
GET {{url}}/{{consultationId}}
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json
