@BASE_URL = http://localhost:3333
@url = {{BASE_URL}}/cases

# Preconditions
# Run `pnpm seed`, start the API on http://localhost:3333, execute the login
# request, then provide a seeded case ID when prompted.

### Sign in as the seeded lawyer
# @name signInAsSeededLawyer
# @prompt seedPassword Enter HMS_USER_SEED_PASSWORD
POST {{BASE_URL}}/auth/sign-in
Content-Type: application/json
Accept: application/json

{
  "identifier": "lawyer@hmsadvogados.com.br",
  "password": "{{seedPassword}}"
}

### Confirm the authenticated collaborator
# @name getCurrentCollaborator
GET {{BASE_URL}}/collaborators/me
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### List my legal cases
# @name listMyLegalCases
GET {{url}}/my
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### List case checklist
# @prompt caseId Enter the case ID to inspect
GET {{url}}/{{caseId}}/checklist
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Load legal-piece generation context (available models and validated checklist files)
# @prompt caseId Enter the case ID to prepare a legal piece
GET {{url}}/{{caseId}}/document-generation-context
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json

### Request an AI-generated legal-piece draft
# @prompt caseId Enter the approved case ID
# @prompt documentSpecificationId Enter an available document model ID from the generation context
# @prompt documentFileId Enter a validated checklist document ID from the generation context
POST {{url}}/{{caseId}}/documents/generations
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json
Accept: application/json

{
  "documentSpecificationId": "{{documentSpecificationId}}",
  "documentFileIds": ["{{documentFileId}}"],
  "instructions": "Use somente fatos comprovados nos documentos selecionados; preserve como pendência toda variável sem evidência."
}

### Retry a stuck or failed legal-piece generation
# @prompt caseId Enter the approved case ID
# @prompt documentId Enter the existing legal-piece document ID
POST {{url}}/{{caseId}}/documents/{{documentId}}/generations/retry
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Accept: application/json


### Add complementary checklist item
# @prompt caseId Enter the case ID to update
POST {{url}}/{{caseId}}/checklist/items
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json
Accept: application/json

{
  "templateItemKey": "complementary-proof",
  "title": "Prova complementar"
}

### Review case checklist gate - approve
# @prompt caseId Enter the case ID to review
PATCH {{url}}/{{caseId}}/checklist-gate
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json

{
  "decision": "approved",
  "decidedBy": "{{getCurrentCollaborator.response.body.$.collaboratorId}}"
}

### Review case checklist gate - approve with exception
# @prompt caseId Enter the case ID to review
PATCH {{url}}/{{caseId}}/checklist-gate
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json

{
  "decision": "approved_with_exception",
  "decidedBy": "{{getCurrentCollaborator.response.body.$.collaboratorId}}",
  "remarks": "Exceção documental previamente autorizada."
}

### Review case checklist gate - reject on merit
# @prompt caseId Enter the case ID to review
PATCH {{url}}/{{caseId}}/checklist-gate
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json

{
  "decision": "rejected_on_merit",
  "decidedBy": "{{getCurrentCollaborator.response.body.$.collaboratorId}}",
  "remarks": "Documentação formal completa, mas insuficiente para sustentar a tese jurídica."
}

### Review case checklist gate - block for insufficient documentation
# @prompt caseId Enter the case ID to review
PATCH {{url}}/{{caseId}}/checklist-gate
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json

{
  "decision": "blocked_insufficient",
  "decidedBy": "{{getCurrentCollaborator.response.body.$.collaboratorId}}",
  "remarks": "Pendências documentais impedem o avanço para produção jurídica."
}

### Homologate case dossier after reviewing all required documents
# @prompt caseId Enter the case ID whose checklist has already been approved
PATCH {{url}}/{{caseId}}/dossier-gate/homologation
Authorization: Bearer {{signInAsSeededLawyer.response.body.$.accessToken}}
Content-Type: application/json
Accept: application/json

{}
