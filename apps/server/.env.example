# NestJS
HMS_SERVER_APP_MODE=
HMS_SERVER_APP_PORT=
HMS_WEB_APP_URL=
HMS_USER_SEED_PASSWORD=

# PostgreSQL
DATABASE_URL=

# OpenRouter
OPENROUTER=

# Local AI
OLLAMA_AI_MODEL=qwen3.5:2b

# Document Validation AI
# deterministic: returns a stable local result for development/demo without calling a model.
# live: calls the configured Mastra model provider. In dev, this uses OLLAMA_AI_MODEL.
DOCUMENT_VALIDATION_AI_MODE=deterministic

# Inngest
INNGEST_DEV=1
INNGEST_BASE_URL=
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=


# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# WhatsApp / Meta Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
