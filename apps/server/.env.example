# NestJS
HMS_SERVER_APP_MODE=
HMS_SERVER_APP_PORT=
HMS_WEB_APP_URL=
HMS_USER_SEED_PASSWORD=

# PostgreSQL
DATABASE_URL=

# OpenRouter (required for document drafting in every environment)
OPENROUTER_API_KEY=

# Optional app telemetry. Leave endpoint unset locally to disable it.
# In Coolify, use the Grafana Cloud OTLP endpoint and a secret Basic auth header.
# Also enables document Writer/Reviewer traces and AI metrics through the same SDK.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(OTLP_INSTANCE_ID:ACCESS_POLICY_TOKEN)>
# OTEL_SERVICE_NAME=hms-server
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=hms,deployment.environment.name=staging


# AI providers (temporary local development selector; staging/production remain on OpenRouter)
AI_PROVIDER=gemini

# Document Engine models (document drafting keeps its own OpenRouter fallback chain).
OPENAI_API_KEY=
OPENAI_AI_MODEL=gpt-6-luna
GEMINI_API_KEY=
GEMINI_AI_MODEL=gemini-3.7-flash

# Vision models are used by OCR/image-analysis agents.
OPENAI_VISION_AI_MODEL=gpt-6-luna
GEMINI_VISION_AI_MODEL=gemini-3.7-flash

# Ollama (default local development provider)

# Text-only local model.
OLLAMA_AI_MODEL=qwen3.5:2b
# Multimodal local model for text + image analysis.
OLLAMA_VISION_AI_MODEL=qwen2.5vl:3b

# Document Validation AI
# deterministic: returns a stable local result for development/demo without calling a model.
# live: calls the configured Mastra model provider. In dev, text agents use
# OLLAMA_AI_MODEL and vision agents use OLLAMA_VISION_AI_MODEL.
DOCUMENT_VALIDATION_AI_MODE=deterministic

# Inngest
INNGEST_DEV=1
INNGEST_BASE_URL=
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
INNGEST_API_KEY=
# Public URL of this server's Inngest endpoint, as registered in Inngest Cloud
INNGEST_APP_URL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hms-bucket

# Optional Documenso health endpoint base URL (GET /api/health)
DOCUMENSO_URL=

# WhatsApp / Meta Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
NGROK_DOMAIN=buckle-stinger-swoop.ngrok-free.dev
