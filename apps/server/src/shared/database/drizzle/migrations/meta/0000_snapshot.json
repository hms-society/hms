      "checkConstraints": {
        "intakes_version_positive_check": {
          "name": "intakes_version_positive_check",
          "value": "\"intakes\".\"version\" > 0"
        },
        "intakes_updated_after_created_check": {
          "name": "intakes_updated_after_created_check",
          "value": "\"intakes\".\"updated_at\" >= \"intakes\".\"created_at\""
        },
        "intakes_closure_fields_check": {
          "name": "intakes_closure_fields_check",
          "value": "(\n        (\n          \"intakes\".\"status\" = 'closed_without_contract'\n          AND \"intakes\".\"closure_reason\" IS NOT NULL\n          AND \"intakes\".\"closed_at\" IS NOT NULL\n        )\n        OR\n        (\n          \"intakes\".\"status\" <> 'closed_without_contract'\n          AND \"intakes\".\"closure_reason\" IS NULL\n          AND \"intakes\".\"closure_notes\" IS NULL\n          AND \"intakes\".\"closed_at\" IS NULL\n        )\n      )"
        },
        "intakes_other_closure_notes_check": {
          "name": "intakes_other_closure_notes_check",
          "value": "\"intakes\".\"closure_reason\" <> 'outro'\n        OR (\n          \"intakes\".\"closure_notes\" IS NOT NULL\n          AND char_length(btrim(\"intakes\".\"closure_notes\")) > 0\n        )"
        }
