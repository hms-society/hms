{
  "name": "hms",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test --filter='!@hms/validation'",
    "test:coverage": "turbo run test:coverage --filter='!@hms/validation'",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check-types": "turbo run check-types",
    "check:complexity": "node scripts/check-complexity.mjs",
    "update:complexity-baseline": "node scripts/check-complexity.mjs --update-baseline",
    "validate": "pnpm check && pnpm check-types && pnpm test && pnpm test:coverage",
    "seed": "pnpm --filter server db:seed",
    "server": "pnpm --filter server dev",
    "web": "pnpm --filter web dev",
    "ngrok": "node scripts/start-ngrok.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "code-multivitals": "1.6.2",
    "dependency-cruiser": "^16.10.4",
    "husky": "^9.1.7",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "^18.17 || >=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "lightningcss"
    ]
  }
}
